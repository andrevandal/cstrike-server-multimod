# Required
RCON_PASSWORD=change-me

# Empty = public server; set to require a join password
SV_PASSWORD=
SERVER_NAME=CS 1.6 Nostalgia | Multi-Mod
# Must be plain http:// (GoldSrc has no TLS); served by the fastdl service on :8080
FASTDL_URL=http://fastdl.vandal.services:8080/
START_MAP=de_dust2
MAXPLAYERS=32

# Comma-separated SteamIDs, e.g. STEAM_0:1:12345,STEAM_0:0:67890
ADMINS=
MODERATORS=

# Anti-cheat (WHBlocker) and dual protocol (Reunion) are on by default; the server refuses to start
# until their binaries are in server/plugins/ (see MANIFEST.md). Set to 0 to opt out.
ANTICHEAT_ENABLED=1
REUNION_ENABLED=1
# Alphanumeric, >= 16 chars. Empty = generated once and kept in state/reunion_salt (backed up)
REUNION_SALT=

BACKUP_CRON_EXPRESSION=0 4 * * *
BACKUP_RETENTION_DAYS=14
TZ=America/Sao_Paulo
